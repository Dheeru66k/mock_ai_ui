# Environment Variables Template
# Copy this to .env and fill in your actual values
# IMPORTANT: Never commit .env with real keys!

# ═══════════════════════════════════════════════════════════════════════════
#  OPENAI API CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Get from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Optional: Organization ID for cost tracking
OPENAI_ORG_ID=org-your-org-id

# ═══════════════════════════════════════════════════════════════════════════
#  ANTHROPIC API CONFIGURATION (Claude)
# ═══════════════════════════════════════════════════════════════════════════
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ═══════════════════════════════════════════════════════════════════════════
#  GOOGLE GEMINI API CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyD-your-key-here

# ═══════════════════════════════════════════════════════════════════════════
#  MISTRAL AI CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Get from: https://console.mistral.ai/
MISTRAL_API_KEY=your-key-here

# ═══════════════════════════════════════════════════════════════════════════
#  AZURE OPENAI CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Get from: Azure Portal → Azure OpenAI resources
AZURE_OPENAI_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_VERSION=2024-02-15-preview

# ═══════════════════════════════════════════════════════════════════════════
#  AZURE ACTIVE DIRECTORY (SSO)
# ═══════════════════════════════════════════════════════════════════════════
# Get from: Azure Portal → App registrations
AZURE_CLIENT_ID=your-client-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_SECRET=your-client-secret

# Redirect URI must match what's registered in the app
# For development: http://localhost:8501
# For production: https://yourdomain.com
AZURE_REDIRECT_URI=http://localhost:8501

# ═══════════════════════════════════════════════════════════════════════════
#  DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# PostgreSQL connection string
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/oesl_ai_ui

# For SQLite (development only):
# DATABASE_URL=sqlite:///./oesl_ai_ui.db

# ═══════════════════════════════════════════════════════════════════════════
#  APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Enable mock data instead of database (for development)
ENABLE_MOCK_DATA=true

# Application environment
APP_ENV=development  # or 'production'

# Log level
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════
#  MONITORING & LOGGING (Optional)
# ═══════════════════════════════════════════════════════════════════════════
# Azure Application Insights
APPINSIGHTS_INSTRUMENTATION_KEY=your-key-here

# Sentry error tracking
SENTRY_DSN=your-sentry-dsn-here

# ═══════════════════════════════════════════════════════════════════════════
#  NOTES
# ═══════════════════════════════════════════════════════════════════════════
# 
# 1. SECURITY: Never commit .env file with real keys!
#    Add to .gitignore:
#    echo ".env" >> .gitignore
#
# 2. LOCAL DEVELOPMENT:
#    - Create .env in project root
#    - Fill with dummy keys (they won't be used with ENABLE_MOCK_DATA=true)
#
# 3. PRODUCTION:
#    - Use environment variables in deployment platform
#    - Or use secrets management system (Azure Key Vault, AWS Secrets Manager)
#    - Never store keys in files
#
# 4. API KEY SOURCES:
#    - OpenAI: https://platform.openai.com/account/api-keys
#    - Anthropic: https://console.anthropic.com/
#    - Google: https://aistudio.google.com/app/apikey
#    - Mistral: https://console.mistral.ai/
#    - Azure OpenAI: Create Azure OpenAI resource
#    - Azure AD: Azure Portal → App registrations
#
